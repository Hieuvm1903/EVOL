# Copy this file to .streamlit/secrets.toml for local dev (never commit the real one),
# or paste the same keys into Streamlit Community Cloud -> App settings -> Secrets.
#
# Without this [r2] section, the app just runs fully local (SQLite file + local
# photos folder) — R2 sync only turns on once these are present.

[r2]
account_id = "your-cloudflare-account-id"
access_key_id = "your-r2-access-key-id"
secret_access_key = "your-r2-secret-access-key"
bucket = "evol-space"
